# .env.example
# O app empacotado usa Configurações + cofre/sessão, não lê .env nem keys de CLIs.
# Variáveis exclusivas dos testes reais opt-in; o app não as lê.
# Nenhum teste padrão depende dela; este arquivo não é carregado automaticamente.
UT_INTEGRATION_OLLAMA_MODEL=
# Opt-in: teste real do sidecar, baixa PT→EN em diretório temporário de QA.
UT_INTEGRATION_LOCAL_ENGINE=
